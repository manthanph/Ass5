<%- include('partials/header', { title: 'Home' }) %>

<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <div class="hero-text">
      <span class="hero-badge">India's #1 Health Insurance</span>
      <h1>Best Health Insurance<br>Plans for Your Family</h1>
      <p>Get comprehensive coverage starting at just <strong>₹30/day</strong>. Trusted by 5 million+ families.</p>
      <div class="hero-stats">
        <div class="stat"><strong>15,000+</strong><span>Network Hospitals</span></div>
        <div class="stat"><strong>5M+</strong><span>Happy Customers</span></div>
        <div class="stat"><strong>99%</strong><span>Claim Settlement</span></div>
      </div>
    </div>

    <!-- Quote Form -->
    <div class="quote-card">
      <h3>Get Your Free Quote</h3>
      <form action="/quotes/request" method="POST">
        <div class="form-group">
          <label>Full Name</label>
          <input type="text" name="name" placeholder="Enter your name" required>
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="your@email.com" required>
        </div>
        <div class="form-group">
          <label>Mobile Number</label>
          <input type="text" name="phone" placeholder="10-digit mobile number" required>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Family Size</label>
            <select name="familySize" required>
              <option value="">Select</option>
              <option>Individual</option>
              <option>Family (2)</option>
              <option>Family (3-4)</option>
              <option>Family (5+)</option>
            </select>
          </div>
          <div class="form-group">
            <label>Sum Insured</label>
            <select name="sumInsured" required>
              <option value="">Select</option>
              <option>₹3 Lakh</option>
              <option>₹5 Lakh</option>
              <option>₹10 Lakh</option>
              <option>₹25 Lakh</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Pincode</label>
          <input type="text" name="pincode" placeholder="Enter pincode" required>
        </div>
        <button type="submit" class="btn btn-primary btn-full">View Plans →</button>
      </form>
    </div>
  </div>
</section>

<!-- FEATURES BAR -->
