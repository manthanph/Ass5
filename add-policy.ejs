<%- include('partials/header', { title: 'Add Policy' }) %>

<section class="page-section">
  <div class="page-header">
    <div>
      <h2>➕ Add New Policy</h2>
      <p>Register a new insurance policy for a customer</p>
    </div>
    <a href="/policies" class="btn btn-outline">← Back to Policies</a>
  </div>

  <div class="form-card">
    <form action="/policies/add" method="POST">

      <div class="form-section-title">Customer Details</div>
      <div class="form-row-3">
        <div class="form-group">
          <label>Full Name *</label>
          <input type="text" name="name" placeholder="Customer full name" required>
        </div>
        <div class="form-group">
          <label>Email *</label>
          <input type="email" name="email" placeholder="customer@email.com" required>
        </div>
        <div class="form-group">
          <label>Phone *</label>
          <input type="text" name="phone" placeholder="10-digit mobile" required>
        </div>
      </div>

      <div class="form-section-title">Policy Details</div>
      <div class="form-row-3">
        <div class="form-group">
          <label>Plan Type *</label>
          <select name="planType" required>
            <option value="">-- Select Plan --</option>
            <option>Basic Care</option>
            <option>Premium Care</option>
            <option>Family Plan</option>
          </select>
        </div>
        <div class="form-group">
          <label>Sum Insured *</label>
          <select name="sumInsured" required>
            <option value="">-- Select Amount --</option>
            <option>₹3 Lakh</option>
            <option>₹5 Lakh</option>
            <option>₹10 Lakh</option>
            <option>₹25 Lakh</option>
          </select>
        </div>
        <div class="form-group">
          <label>Family Size *</label>
          <select name="familySize" required>
            <option value="">-- Select --</option>
            <option>Individual</option>
            <option>Family (2)</option>
            <option>Family (3-4)</option>
            <option>Family (5+)</option>
          </select>
        </div>
      </div>

      <div class="form-row-3">
        <div class="form-group">
          <label>Annual Premium (₹) *</label>
          <input type="number" name="premium" placeholder="e.g. 9000" min="1" required>
        </div>
        <div class="form-group">
          <label>Start Date *</label>
          <input type="date" name="startDate" required>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select name="status">
            <option>Active</option>
            <option>Pending</option>
            <option>Expired</option>
          </select>
        </div>
      </div>

      <div class="form-actions">
        <a href="/policies" class="btn btn-outline">Cancel</a>
        <button type="submit" class="btn btn-primary">Save Policy</button>
      </div>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
